% Determine if elements are next to each other in a list.
adjacent(X,Y,Zs) :- append_to_list(As,[X,Y|Ys],Zs).

%TRUE_NO adjacent(a,b,[a,b,c,d,e,f])
%TRUE_NO adjacent(c,d,[a,b,c,d,e,f])

% X=b
% Y=f
% Z=d
%NO
%?- append_to_list([a,X,c],[Y,e(X,Y),f],[a,b,c,d,Z,f])
% X=b
% Y=d
% Z=e(b, d)
%NO
%?- append_to_list([a,b,c],[d,e,f],X)
% X=[a,b,c,d,e,f]

list_member(X,[X|Xs]).
list_member(X,[Y|Ys]) :- list_member(X,Ys).

%?- list_member(X, [a,b,c])
% X=a
% X=b
% X=c
%NO

%TRUE_NO list_member(a, [a,b,c])

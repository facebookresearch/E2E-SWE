y1(X,Y,Z) :- assert(a1(1,3,5)), test_repeat1(3), asserta(a1(2,4,6)), assertz(a1(3,6,9)), a1(X,Y,Z).

z1(X,Y,Z) :- assert(b1(1,2,3)), assert(b1(4,5,6)), assert(b1(7,8,9)), test_repeat1(3), b1(X,Y,Z).


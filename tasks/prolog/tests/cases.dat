%FAIL suffix([a,b],[a,b,c])
%?- suffix([X,c],[a,b,c])
% X=b
%NO

% Determining sublists of lists.

sublist(Xs,Ys) :- prefix(Xs,Ys).
sublist(Xs,[Y|Ys]) :- sublist(Xs,Ys).

%TRUE_NO sublist([a,b,c],[a,b,c,d,e,f])
%TRUE_NO sublist([b,c,d],[a,b,c,d,e,f])
